APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
API_PORT=8080
API_CONTAINER_PORT=8080
API_STOP_GRACE_PERIOD=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=1m
HTTP_SHUTDOWN_TIMEOUT=5s
APP_ORIGIN=http://127.0.0.1:8080
SITE_ADDRESS=:80
POSTGRES_DB=focusboard
POSTGRES_USER=focusboard
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://focusboard:change-me-local-only@db:5432/focusboard?sslmode=disable
DB_CONNECT_TIMEOUT=3s
DB_CHECK_TIMEOUT=1s
DB_POOL_MAX_CONNS=10
DB_POOL_MIN_CONNS=0
DB_MAX_CONN_IDLE_TIME=5m
DB_MAX_CONN_LIFETIME=1h
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_ISSUER=focusboard
JWT_AUDIENCE=focusboard-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
REFRESH_COOKIE_NAME=focusboard_refresh
COOKIE_SECURE=false
AUTH_REQUEST_TIMEOUT=8s
AUTH_RATE_WINDOW=1m
AUTH_RATE_IP_LIMIT=60
AUTH_RATE_ACCOUNT_LIMIT=10
AUTH_RATE_MAX_KEYS=8192
AUTH_PASSWORD_WORKERS=2
LOG_LEVEL=info
